# ==============================================================================
# Environment Configuration Template
# Copy or rename this file to '.env.example' for public repository check-ins.
# Fill in real secret values locally or in your deployment secret manager.
# ==============================================================================

# Adzuna Job Search API Credentials
# Register at https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# JWT Authentication
# Secret key used for signing user authentication JSON Web Tokens.
# Generate a strong key using: `openssl rand -hex 32`
JWT_SECRET_KEY=your_random_32_byte_hex_secret_key_here
JWT_EXPIRE_MINUTES=60

# Database Connection
# Defaults to local Docker Compose setup if commented out.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/job_analytics

# CORS Settings
# Comma-separated list of allowed cross-origin request origins.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Monitoring & Error Tracking
# Sentry DSN from sentry.io project settings.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Caching (Redis)
# Caches heavy aggregate endpoints (/trends, /roles/transition-graph, /skills/{skill}/related).
REDIS_URL=redis://localhost:6379/0

# Ingestion Pipeline Schedule
# Cron syntax for scheduler.py (Default: Daily at 03:00 UTC).
INGESTION_CRON=0 3 * * *