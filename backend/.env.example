# Adzuna Job Search API credentials — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Signing key for user auth JWTs — set a long random value in any real deployment.
# openssl rand -hex 32
JWT_SECRET_KEY=

# Optional — access token lifetime in minutes (default 60)
# JWT_EXPIRE_MINUTES=60

# Optional — overrides the default local Docker Compose connection string.
# Set this when running against a hosted Postgres instance (e.g. Supabase, Neon, Render).
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Comma-separated list of frontend origins allowed to call this API (CORS).
# Defaults to common local dev ports if unset.
# FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.example.com

# Sentry error tracking DSN (sentry.io project settings)
SENTRY_DSN=
