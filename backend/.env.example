# Adzuna Job Search API credentials — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# API key required by protected endpoints (POST /recommend, POST /recommend/evidence)
NEXTSKILL_API_KEY=

# Optional — overrides the default local Docker Compose connection string.
# Set this when running against a hosted Postgres instance (e.g. Supabase, Neon, Render).
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
